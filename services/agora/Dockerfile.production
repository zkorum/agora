# syntax=docker/dockerfile:1

# ---- Dependencies ----
FROM node:24.14.1-alpine AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12.4.1 --activate
ENV PATH=/app/node_modules/.bin:$PATH
# Copy manifest files then full source before install:
# quasar's prepare lifecycle script (run during pnpm install) needs the full source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY . ./
RUN pnpm install --frozen-lockfile

# ---- Build ----
FROM deps AS build
RUN --mount=type=secret,id=sentry_auth_token,target=/app/.env.sentry-build-plugin,required=true \
    pnpm run build:production

# ---- Production ----
FROM nginx:stable-alpine
COPY ./nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/spa /usr/share/nginx/html
# Stage new assets separately so entrypoint can merge them into a persistent volume.
# This allows old chunk files from previous deployments to remain available,
# preventing "Failed to fetch dynamically imported module" errors for users
# whose browser loaded index.html before the deployment.
COPY --from=build /app/dist/spa/assets /app/new-assets
# Sourcemaps were uploaded to Sentry during build; remove them from the image.
RUN find /usr/share/nginx/html /app/new-assets -name "*.map" -delete
COPY ./entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
