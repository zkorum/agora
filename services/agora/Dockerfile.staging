# ---- Dependencies ----
# The frontend output is architecture-independent; avoid emulating build tools.
FROM --platform=$BUILDPLATFORM node:26.13.1-alpine AS deps
RUN apk add --no-cache 'ca-certificates>=20261020-r0'
WORKDIR /app
RUN npm install --global pnpm@12.4.1
ENV PATH=/app/node_modules/.bin:$PATH
# Copy manifest files then full source before install:
# quasar's prepare lifecycle script (run during pnpm install) needs the full source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY . ./
RUN pnpm install --frozen-lockfile

# ---- Build ----
FROM deps AS build
RUN pnpm run build:staging

# ---- Production ----
# Reset the target after the native build stage, including its CPU variant.
FROM --platform=$TARGETPLATFORM nginx:stable-alpine
RUN apk add --no-cache 'ca-certificates>=20261020-r0'
COPY ./nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/spa /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
