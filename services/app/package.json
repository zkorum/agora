{
  "name": "app",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.4.1",
  "license": "MPL-2.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:projects": "playwright test --config playwright.projects.config.ts",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir storybook-static --disable-telemetry",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "lint:fix": "eslint --fix --max-warnings 0 . && prettier --write .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.104",
    "@iconify-json/simple-icons": "^1.2.80",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/svelte-vite": "10.6.6",
    "@sveltejs/adapter-netlify": "7.0.1",
    "@sveltejs/enhanced-img": "1.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@types/html-to-text": "9.0.4",
    "@types/node": "^25.6.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-better-tailwindcss": "^4.4.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "storybook": "10.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.6",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.16.1",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@sentry/sveltekit": "11.11.0",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-bubble-menu": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "bits-ui": "^2.18.0",
    "gray-matter": "^4.0.3",
    "html-to-text": "9.0.5",
    "linkify-html": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "2.18.1",
    "svelte-sonner": "^1.2.3",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  }
}
