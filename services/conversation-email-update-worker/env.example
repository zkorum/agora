NODE_ENV="development"
AGORA_DEV_MODE="true"
CONNECTION_STRING="postgres://postgres:postgres@127.0.0.1:5432/agora"
# CONNECTION_STRING_READ="postgres://postgres:postgres@127.0.0.1:5433/agora"

CONVERSATION_EMAIL_UPDATES_ENABLED="false"
CONVERSATION_EMAIL_UPDATES_KILL_SWITCH="true"
# CONVERSATION_EMAIL_UPDATE_SES_REGION="eu-west-1"
# CONVERSATION_EMAIL_UPDATE_EMAIL_FROM_ADDRESS="conversation@updates.agoracitizen.network"
# CONVERSATION_EMAIL_UPDATE_SES_CONFIGURATION_SET="conversation-updates"
CONVERSATION_EMAIL_UPDATE_SITE_BASE_URL="https://www.agoracitizen.app"
CONVERSATION_EMAIL_UPDATE_WORKER_POLL_INTERVAL_MS="1000"
CONVERSATION_EMAIL_UPDATE_WORKER_HEARTBEAT_INTERVAL_MS="60000"
CONVERSATION_EMAIL_UPDATE_WORKER_BATCH_SIZE="25"
CONVERSATION_EMAIL_UPDATE_WORKER_CONCURRENCY="4"
CONVERSATION_EMAIL_UPDATE_WORKER_SENDS_PER_SECOND="5"
CONVERSATION_EMAIL_UPDATE_WORKER_LEASE_SECONDS="120"
CONVERSATION_EMAIL_UPDATE_REQUEST_TIMEOUT_MS="20000"
# CONVERSATION_EMAIL_UPDATE_WORKER_LOG_LEVEL="debug"

# Development-only SES provider simulator. Startup rejects this configuration
# outside NODE_ENV=development with AGORA_DEV_MODE=true.
CONVERSATION_EMAIL_UPDATE_PROVIDER="ses"
CONVERSATION_EMAIL_UPDATE_SIMULATOR_ENABLED="false"
CONVERSATION_EMAIL_UPDATE_SIMULATOR_MODE="success"
CONVERSATION_EMAIL_UPDATE_SIMULATOR_RETRYABLE_FAILURES="1"

# The separate fail-closed exercise uses `.env.dev-exercise`, not this file.
# Start from `env.dev-exercise.example`; see README.md.
