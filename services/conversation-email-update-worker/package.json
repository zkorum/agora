{
    "name": "@zkorum/agora-conversation-email-update-worker",
    "version": "1.0.0",
    "description": "Durable Conversation Email Updates delivery and SES event worker",
    "packageManager": "pnpm@10.34.5",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && tsc --sourceMap -p tsconfig.build.json && node assertProductionBuild.mjs",
        "start": "node --loader esm-module-alias/loader --no-warnings dist/index.js",
        "start:dev": "tsx watch --trace-uncaught src/index.ts",
        "dev:exercise": "./run-dev-exercise.sh",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:dev-exercise": "vitest run src/devExercise",
        "test:dev-exercise:process": "vitest run src/devExercise/entrypoint.process.test.ts",
        "format:write": "prettier --write \"**/*.{js,ts,json,md}\"",
        "format:check": "prettier . --check",
        "image:buildx": "sh -c 'tag=${TAG:-${1:-latest}}; tag=${tag#TAG=}; docker buildx build --platform linux/amd64 -t agora-conversation-email-update-worker:$tag --load .' --",
        "image:build": "sh -c 'tag=${TAG:-${1:-latest}}; tag=${tag#TAG=}; docker build -t agora-conversation-email-update-worker:$tag .' --",
        "image:tag": "sh -c 'tag=${TAG:-${1:-latest}}; tag=${tag#TAG=}; docker tag agora-conversation-email-update-worker:$tag quay.io/zkorum/agora-conversation-email-update-worker:$tag' --",
        "image:push": "sh -c 'tag=${TAG:-${1:-latest}}; tag=${tag#TAG=}; TAG=\"$tag\" pnpm run image:tag && docker image push quay.io/zkorum/agora-conversation-email-update-worker:$tag' --"
    },
    "author": "ZKorum SAS <hello@zkorum.com>",
    "license": "AGPL-3.0",
    "aliases": {
        "@": "./dist"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.1024.0",
        "@aws-sdk/client-sesv2": "^3.1024.0",
        "dotenv": "^17.4.1",
        "drizzle-orm": "^0.45.2",
        "esm-module-alias": "^2.2.1",
        "html-to-text": "9.0.5",
        "pino": "10.3.1",
        "postgres": "^3.4.9",
        "sanitize-html": "2.17.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/eslint__js": "^8.42.3",
        "@types/html-to-text": "9.0.4",
        "@types/node": "^25.5.2",
        "@types/sanitize-html": "^2.16.1",
        "@valkey/valkey-glide": "^2.3.1",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.5",
        "vitest": "^4.1.2"
    }
}
