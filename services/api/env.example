CORS_ORIGIN_LIST="http://localhost:9000,http://127.0.0.1:9000,http://172.19.0.1:9000,http://192.168.1.22:9000"
CONNECTION_STRING="postgres://{POSTGRES_USER}:{POSTGRES_PASSWORD}@0.0.0.0:{PORT}/{POSTGRES_DB}" # Get values from docker-compose.yml
# Optional: Read replica for improved performance (local: port 5433, AWS RDS: use read replica endpoint)
# CONNECTION_STRING_READ="postgres://{POSTGRES_USER}:{POSTGRES_PASSWORD}@0.0.0.0:5433/{POSTGRES_DB}"
# For AWS RDS with read replica:
# AWS_SECRET_ID_READ=your-replica-secret-id
# AWS_SECRET_REGION_READ=us-east-1
# DB_HOST_READ=your-replica.rds.amazonaws.com
# DB_PORT_READ=5432
PEPPERS="fmgXvsChQsx9fAlq0DPiVg=="
SPECIALLY_AUTHORIZED_PHONES="+33612345678,+12345678910"
# enabled: phone login and registration; login_only: existing accounts only;
# disabled: temporary technical shutdown of all phone authentication
PHONE_AUTH_MODE="enabled"
# Equalize login-only responses so Twilio and database latency cannot reveal whether an account exists.
PHONE_LOGIN_ONLY_RESPONSE_MIN_MS=2000
PHONE_LOGIN_ONLY_RESPONSE_JITTER_MS=500
# Wrong email OTP guesses shared across all DIDs for one canonical address.
EMAIL_OTP_DESTINATION_MAX_WRONG_GUESSES=10
VERIFICATOR_SVC_BASE_URL="http://verificator-svc"

# Valkey configuration (optional - for vote/import/export buffer persistence across instances)
# If not set, buffers will use in-memory storage only (lost on restart)
# QUEUE_VALKEY_URL="valkey://localhost:6379"
# NOSTR_PROOF_CHANNEL_EVENT_ID="6cde92f2a057368e4871d5dac0f830e09f399bad666a2070e4c4c6c40d235667"
# NOSTR_DEFAULT_RELAY_URL="wss://nos.lol"
REACHER_BASE_URL="http://127.0.0.1:8080"
PORT=8084
SERVER_DID_DEV=did:web:localhost%3A8084

# Expected SNS topic for Conversation Email Updates ingress (route wiring is separate).
# CONVERSATION_EMAIL_UPDATE_EXPECTED_SNS_TOPIC_ARN="arn:aws:sns:eu-west-1:123456789012:conversation-updates-ses-events"
# These must match the standalone Email Updates worker deployment.
CONVERSATION_EMAIL_UPDATES_ENABLED="false"
CONVERSATION_EMAIL_UPDATES_KILL_SWITCH="true"
# Development-only site-admin endpoint for inserting simulated SES/SNS events.
# The API rejects this flag unless NODE_ENV=development.
CONVERSATION_EMAIL_UPDATE_SNS_SIMULATOR_ENABLED="false"

# S3 configuration for conversation CSV exports
EXPORT_CONVOS_AWS_S3_REGION="us-east-1"
EXPORT_CONVOS_AWS_S3_BUCKET_NAME="your-bucket-name"
EXPORT_CONVOS_EXPIRY_DAYS=30
EXPORT_CONVOS_COOLDOWN_SECONDS=300
EXPORT_CONVOS_S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# Conversation export feature toggle
EXPORT_CONVOS_ENABLED=true

# Private S3 bucket for persistent project documents (no expiry lifecycle)
PROJECT_DOCUMENTS_AWS_S3_REGION="us-east-1"
PROJECT_DOCUMENTS_AWS_S3_BUCKET_NAME="your-project-documents-bucket-name"
# Dedicated private bucket with S3 Block Public Access enabled; do not enable static website hosting.
PROJECT_DOCUMENTS_S3_PRESIGNED_URL_EXPIRY_SECONDS=600

# Import restriction configuration
# If true, only organization accounts can import conversations (Polis URL & CSV)
# If false, all users can import conversations
IS_ORG_IMPORT_ONLY=false

# AWS Credentials (only needed for local development)
# For production deployments on AWS (ECS/Fargate/EC2/EKS), use IAM roles instead
# Leave these commented out when deploying to AWS with IAM roles
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
